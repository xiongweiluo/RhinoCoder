{
  "schema_version": "1.0",
  "privacy": {
    "catalog_contains_real_user_data": false,
    "replays_are_synthetic": true,
    "browser_payload_policy": "minimized_and_object_ids_pseudonymized"
  },
  "scenarios": [
    {
      "id": "normal-loop",
      "title": "正常闭环",
      "kicker": "EXECUTE → OBSERVE → ASSERT",
      "goal": "验证 Agent 能在 Rhino 中创建基座与球体，并以真实场景读回和几何断言结束任务。",
      "input": "在原点创建一个 20x20x2 的基座，再在顶面居中放一个半径 8 的红色球体。",
      "expected": [
        "场景中存在一个 20×20×2 基座",
        "红色球体尺寸为 16×16×16",
        "球体与基座顶面居中贴合"
      ],
      "replay": "basic_stack.json",
      "evidence": {
        "label": "A6 固定真实 Rhino 基线",
        "path": "a6-no-finetune-baseline.md"
      },
      "asserts": [
        {
          "kind": "count",
          "selector": {},
          "n": 2,
          "label": "场景对象数量",
          "expected_text": "2 个对象"
        },
        {
          "kind": "property",
          "selector": {"name": "Base"},
          "props": {"size": [20, 20, 2]},
          "label": "基座尺寸",
          "expected_text": "20×20×2"
        },
        {
          "kind": "property",
          "selector": {"name": "Sphere"},
          "props": {"size": [16, 16, 16]},
          "label": "球体半径与包围盒",
          "expected_text": "半径 8；包围盒 16×16×16"
        },
        {
          "kind": "property",
          "selector": {"name": "Sphere"},
          "props": {"color": [255, 0, 0]},
          "label": "球体颜色",
          "expected_text": "RGB 255/0/0"
        },
        {
          "kind": "spatial",
          "a": {"name": "Sphere"},
          "b": {"name": "Base"},
          "relation": "on_top_of",
          "label": "球体位置",
          "expected_text": "中心 [0,0,10]；底面贴合基座顶面且 XY 对齐"
        }
      ]
    },
    {
      "id": "self-correction",
      "title": "错误恢复",
      "kicker": "MISMATCH → CORRECT → RECHECK",
      "goal": "展示第一次场景断言不匹配后，Agent 修改尺寸和颜色，再次读取 Rhino 并分别通过几何与颜色断言。",
      "input": "创建一个蓝色球体；读取场景，如尺寸或颜色不符则修正到半径 12、RGB 0/0/255 后再次验证。",
      "expected": [
        "第一次断言明确显示尺寸与颜色不匹配",
        "纠错调用不会重复创建球体",
        "复检后尺寸 24×24×24 且颜色为蓝色"
      ],
      "replay": "self_correction.json",
      "evidence": {
        "label": "P0 合成纠错链与证据说明",
        "path": "portfolio-evidence.md"
      },
      "asserts": [
        {
          "kind": "count",
          "selector": {"type": "Surface", "size": [24, 24, 24]},
          "n": 1,
          "label": "纠错后的球体半径",
          "expected_text": "半径 12；包围盒 24×24×24"
        },
        {
          "kind": "property",
          "selector": {"type": "Surface", "size": [24, 24, 24]},
          "props": {"color": [0, 0, 255]},
          "label": "纠错后的球体颜色",
          "expected_text": "RGB 0/0/255"
        }
      ]
    },
    {
      "id": "privacy-route",
      "title": "隐私与路由",
      "kicker": "MINIMIZE → ROUTE → AUDIT",
      "goal": "展示合成邮箱信号在模型调用前被最小化，再由规则路由选择后端，并保留可审计决策。",
      "input": "将联系人邮箱 contact@example.invalid 从云请求中移除，然后搭建 60x40x4 桌面和四条 4x4x30 桌腿并分组。",
      "expected": [
        "隐私风险为 medium，动作是 minimize_cloud",
        "浏览器与模型载荷只显示 <EMAIL_REDACTED>",
        "路由、工具、断言与指标共享 replay-table run_id"
      ],
      "replay": "table_group.json",
      "evidence": {
        "label": "A4 隐私红队与零泄漏报告",
        "path": "privacy-red-team-report.md"
      },
      "asserts": [
        {
          "kind": "count",
          "selector": {"type": ["Polysurface", "Extrusion"]},
          "n": 5,
          "label": "桌子成员数量",
          "expected_text": "空白演示文档中共 5 个桌子构件"
        },
        {
          "kind": "property",
          "selector": {"name": "TableTop"},
          "props": {"size": [60, 40, 4]},
          "label": "桌面尺寸",
          "expected_text": "60×40×4"
        },
        {
          "kind": "count",
          "selector": {"in_group": "demo-table"},
          "n": 5,
          "label": "分组完整性",
          "expected_text": "5 个构件属于同一组合成群组"
        }
      ]
    }
  ]
}
