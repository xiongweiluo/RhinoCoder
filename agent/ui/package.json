{
  "name": "rhinocoder-ui",
  "private": true,
  "version": "0.3.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "build:public": "tsc -b && vite build --mode public",
    "typecheck": "tsc -b",
    "test:e2e": "playwright test",
    "test:e2e:public": "npm run build:public && playwright test --config playwright.public.config.ts",
    "preview:public": "vite preview --host 127.0.0.1 --port 7863 --strictPort",
    "preview": "vite preview --host 127.0.0.1"
  },
  "dependencies": {
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@vitejs/plugin-react": "6.1.0",
    "typescript": "7.0.2",
    "vite": "8.2.2"
  }
}
