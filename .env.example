# 复制为 .env 后填写本地配置。不要提交 .env 或任何真实密钥。
DEEPSEEK_API_KEY=<your-deepseek-api-key>

# OpenAI-compatible 模型配置
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-v4-pro
LLM_TIMEOUT_SECONDS=90
LLM_MAX_RETRIES=1

# 可选：用于评测清场端点。Rhino 进程与评测进程必须使用相同值。
RHINOCODER_EVAL_TOKEN=<generate-a-random-local-token>

# 可选：覆盖内置模型价格；单位为 USD / 1M tokens。
# deepseek-v4-pro + api.deepseek.com 默认使用官方常规价：
# 缓存命中输入 0.003625、缓存未命中输入 0.435、输出 0.87。
# 官方价格页可能调整价格；自定义兼容 API 必须显式配置。
# LLM_INPUT_CACHE_HIT_COST_PER_M_TOKENS=0.003625
# LLM_INPUT_CACHE_MISS_COST_PER_M_TOKENS=0.435
# LLM_OUTPUT_COST_PER_M_TOKENS=0.87
# LLM_PRICING_CHECKED_AT=2026-08-27
# LLM_PRICING_SCHEDULE=regular
