# 复制为 .env 后填写本地配置。不要提交 .env 或任何真实密钥。
DEEPSEEK_API_KEY=<your-deepseek-api-key>

# OpenAI-compatible 模型配置
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-v4-pro
LLM_TIMEOUT_SECONDS=90
LLM_MAX_RETRIES=1

# 规则优先混合路由。auto 会在可靠主模型、低成本云模型和本地 Mock 后端间选择。
RHINOCODER_ROUTER_ENABLED=1
RHINOCODER_ROUTE_MODE=auto
RHINOCODER_ROUTER_FALLBACK=1
RHINOCODER_ROUTER_MAX_FALLBACKS=1
RHINOCODER_ECONOMY_MODEL=deepseek-v4-flash
# RHINOCODER_ECONOMY_BASE_URL=https://api.deepseek.com/v1
# RHINOCODER_ECONOMY_API_KEY=<optional-separate-economy-key>
RHINOCODER_LOCAL_MODEL=mock-local-v1

# 云模型请求审计：只记录隐私最小化后的实际出站消息和静态工具定义，文件权限为 0600。
RHINOCODER_MODEL_REQUEST_AUDIT_ENABLED=1
# RHINOCODER_MODEL_REQUEST_AUDIT=data/audit/model_requests.jsonl

# 可选：用于评测清场端点。Rhino 进程与评测进程必须使用相同值。
RHINOCODER_EVAL_TOKEN=<generate-a-random-local-token>

# 可选：覆盖内置模型价格；单位为 USD / 1M tokens。
# deepseek-v4-pro + api.deepseek.com 默认使用官方常规价：
# 缓存命中输入 0.003625、缓存未命中输入 0.435、输出 0.87。
# 官方价格页可能调整价格；自定义兼容 API 必须显式配置。
# LLM_INPUT_CACHE_HIT_COST_PER_M_TOKENS=0.003625
# LLM_INPUT_CACHE_MISS_COST_PER_M_TOKENS=0.435
# LLM_OUTPUT_COST_PER_M_TOKENS=0.87
# LLM_PRICING_CHECKED_AT=2026-08-27
# LLM_PRICING_SCHEDULE=regular
