# 复制为 .env 后填写本地配置。不要提交 .env 或任何真实密钥。
DEEPSEEK_API_KEY=<your-deepseek-api-key>

# OpenAI-compatible 模型配置
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat
LLM_TIMEOUT_SECONDS=90
LLM_MAX_RETRIES=1

# 可选：用于评测清场端点。Rhino 进程与评测进程必须使用相同值。
RHINOCODER_EVAL_TOKEN=<generate-a-random-local-token>

# 可选：用于估算成本；单位为 USD / 1M tokens。默认 0 表示不估算。
LLM_INPUT_COST_PER_M_TOKENS=0
LLM_OUTPUT_COST_PER_M_TOKENS=0
